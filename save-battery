#!/bin/sh
# save-battery — battery optimisation in one shot.
#
# Every run first switches TLP to its manual "power-saver" profile (TLP 1.9+),
# then applies one of two extra optimisation profiles on top of it:
#
#   maximum   aggressive: kills apps/services, 1% brightness, GPU/BT/WiFi off
#   balanced  moderate: heavy apps only, dimmed screen, GPU/BT/WiFi off
#   none      TLP power-saver only, nothing else touched
#
# TLP's power-saver profile reads the *_ON_SAV settings from /etc/tlp.conf, so
# the profile settings below are written to both *_ON_SAV and *_ON_BAT. Going
# back to automatic AC/battery switching is just `tlp start`, done by --restore.
#
# Usage:
#   save-battery                       interactive menu, then prompt per action
#   save-battery -p maximum -a         apply maximum, no prompts
#   save-battery -p balanced           apply balanced, prompt per action
#   save-battery -p none               TLP power-saver only
#   save-battery -r                    restore normal state
#   save-battery -s                    show status

CACHE_DIR="$HOME/.cache/save-battery"
STATE_FILE="$CACHE_DIR/profile"
KILLED_APPS="$CACHE_DIR/killed-apps"
STOPPED_SERVICES="$CACHE_DIR/stopped-services"
LOG_FILE="/tmp/save-battery.log"

TLP_CONFIG="/etc/tlp.conf"
TLP_BACKUP="$CACHE_DIR/tlp.conf.backup"
UNDERVOLT_CONFIG="/etc/intel-undervolt.conf"
UNDERVOLT_BACKUP="$CACHE_DIR/intel-undervolt.conf.backup"

WALLPAPER="$HOME/.config/.wallpaper/black.png"
COMPOSITOR_SCRIPT="$HOME/.scripts/start-stop-compositor.sh"
TERMINAL="${TERMINAL:-st}"

mkdir -p "$CACHE_DIR"

log() {
	printf '[%s] %s\n' "$(date '+%H:%M:%S')" "$1" | tee -a "$LOG_FILE"
}

err() {
	printf 'error: %s\n' "$1" >&2
	notify-send -u critical "Save battery" "$1" 2>/dev/null || true
	exit 1
}

# Ask a yes/no question through dmenu. Returns 0 only on an explicit "Yes".
confirm() {
	[ "$(printf 'No\nYes' | dmenu -p "$1" 2>/dev/null)" = "Yes" ]
}

# In interactive mode ask first; in auto mode just run it.
maybe() {
	question="$1"
	shift
	if [ "$INTERACTIVE" = "true" ]; then
		confirm "$question" || return 1
	fi
	"$@"
}

# ---------------------------------------------------------------- TLP profile

# Current profile as reported by TLP, e.g. "power-saver/BAT" -> "power-saver"
current_profile() {
	tlp-stat -s 2>/dev/null |
		sed -n 's/^TLP profile[[:space:]]*=[[:space:]]*\([^/]*\).*/\1/p' |
		tr -d ' '
}

# Run a tlp subcommand as root. sudo is used non-interactively when the
# credentials are already cached; otherwise fall back to a terminal so the
# password can be typed (this script is normally launched from dmenu, which
# has no tty of its own).
run_tlp() {
	if sudo -n true 2>/dev/null; then
		sudo tlp "$1" >/dev/null 2>&1 || err "tlp $1 failed"
	elif [ -t 0 ]; then
		sudo tlp "$1" >/dev/null || err "tlp $1 failed"
	else
		"$TERMINAL" -e sudo tlp "$1" ||
			err "tlp $1 failed (could not obtain root)"
	fi
}

enable_power_saver() {
	if [ "$(current_profile)" = "power-saver" ]; then
		log "TLP power-saver profile already active"
		return 0
	fi
	run_tlp power-saver
	log "TLP power-saver profile enabled"
}

disable_power_saver() {
	if [ "$(current_profile)" != "power-saver" ]; then
		log "TLP already on automatic AC/battery switching"
		return 0
	fi
	run_tlp start
	log "TLP back to automatic (now: $(current_profile))"
}

# ------------------------------------------------------------ config handling

backup_config() {
	src="$1"
	dst="$2"
	if [ -f "$src" ] && [ ! -f "$dst" ]; then
		sudo cp "$src" "$dst" 2>/dev/null || {
			log "failed to back up $src"
			return 1
		}
		sudo chown "$(id -u):$(id -g)" "$dst" 2>/dev/null
		log "backed up $src"
	fi
}

restore_config() {
	src="$1"
	dst="$2"
	[ -f "$src" ] || return 0
	sudo cp "$src" "$dst" 2>/dev/null || {
		log "failed to restore $dst"
		return 1
	}
	rm -f "$src"
	log "restored $dst"
}

# Set SETTING_ON_SAV and SETTING_ON_BAT to the given value, but only when the
# key already exists in tlp.conf — unknown keys are skipped instead of being
# appended, so an invalid setting never ends up in /etc/tlp.conf.
apply_tlp_setting() {
	setting="$1"
	value="$2"
	found=false
	for suffix in ON_SAV ON_BAT; do
		key="${setting}_${suffix}"
		if grep -q "^#\{0,1\}${key}=" "$TLP_CONFIG" 2>/dev/null; then
			sudo sed -i "s|^#\{0,1\}${key}=.*|${key}=${value}|" "$TLP_CONFIG"
			found=true
		fi
	done
	[ "$found" = "true" ] || log "skipped unknown TLP setting: $setting"
}

configure_tlp() {
	profile="$1"

	[ -f "$TLP_CONFIG" ] || {
		log "TLP configuration not found at $TLP_CONFIG"
		return 1
	}

	if [ "$INTERACTIVE" = "true" ]; then
		confirm "Tune $TLP_CONFIG for the $profile profile?" || {
			log "skipping TLP configuration"
			return 0
		}
	fi

	backup_config "$TLP_CONFIG" "$TLP_BACKUP"
	log "configuring TLP for profile: $profile"

	if [ "$profile" = "maximum" ]; then
		apply_tlp_setting CPU_SCALING_GOVERNOR powersave
		apply_tlp_setting CPU_ENERGY_PERF_POLICY power
		apply_tlp_setting CPU_BOOST 0
		apply_tlp_setting CPU_HWP_DYN_BOOST 0
		apply_tlp_setting CPU_MIN_PERF 0
		apply_tlp_setting CPU_MAX_PERF 30
		apply_tlp_setting PLATFORM_PROFILE low-power
		apply_tlp_setting SATA_LINKPWR min_power
		apply_tlp_setting PCIE_ASPM powersupersave
		apply_tlp_setting DISK_SPINDOWN_TIMEOUT "0 1"
		apply_tlp_setting DISK_APM_LEVEL "1 1"
		apply_tlp_setting WIFI_PWR on
		apply_tlp_setting SOUND_POWER_SAVE 1
		apply_tlp_setting RUNTIME_PM auto
	else
		apply_tlp_setting CPU_SCALING_GOVERNOR powersave
		apply_tlp_setting CPU_ENERGY_PERF_POLICY balance_power
		apply_tlp_setting CPU_BOOST 0
		apply_tlp_setting CPU_HWP_DYN_BOOST 0
		apply_tlp_setting CPU_MIN_PERF 20
		apply_tlp_setting CPU_MAX_PERF 60
		apply_tlp_setting PLATFORM_PROFILE low-power
		apply_tlp_setting SATA_LINKPWR min_power
		apply_tlp_setting PCIE_ASPM powersave
		apply_tlp_setting DISK_SPINDOWN_TIMEOUT "0 5"
		apply_tlp_setting DISK_APM_LEVEL "128 128"
		apply_tlp_setting WIFI_PWR on
		apply_tlp_setting SOUND_POWER_SAVE 1
	fi

	# Re-read the edited config while staying on the power-saver profile.
	run_tlp power-saver
	log "TLP configured for $profile profile"
}

configure_undervolt() {
	profile="$1"

	[ -f "$UNDERVOLT_CONFIG" ] || {
		log "intel-undervolt config not found, skipping"
		return 0
	}

	if [ "$INTERACTIVE" = "true" ]; then
		confirm "Configure intel-undervolt for $profile?" || {
			log "skipping intel-undervolt configuration"
			return 0
		}
	fi

	backup_config "$UNDERVOLT_CONFIG" "$UNDERVOLT_BACKUP"
	log "configuring intel-undervolt for profile: $profile"

	if [ "$profile" = "maximum" ]; then
		sudo sed -i "s|^undervolt 0 .*|undervolt 0 'CPU' -130|" "$UNDERVOLT_CONFIG"
		sudo sed -i "s|^undervolt 1 .*|undervolt 1 'GPU' -50|" "$UNDERVOLT_CONFIG"
		sudo sed -i "s|^undervolt 2 .*|undervolt 2 'CPU Cache' -80|" "$UNDERVOLT_CONFIG"
		sudo sed -i "s|^undervolt 3 .*|undervolt 3 'System Agent' -10|" "$UNDERVOLT_CONFIG"
		sudo sed -i "s|^undervolt 4 .*|undervolt 4 'Analog I/O' -10|" "$UNDERVOLT_CONFIG"
		sudo sed -i "s|^tjoffset .*|tjoffset -10|" "$UNDERVOLT_CONFIG"
	else
		sudo sed -i "s|^undervolt 0 .*|undervolt 0 'CPU' -50|" "$UNDERVOLT_CONFIG"
		sudo sed -i "s|^undervolt 1 .*|undervolt 1 'GPU' 0|" "$UNDERVOLT_CONFIG"
		sudo sed -i "s|^undervolt 2 .*|undervolt 2 'CPU Cache' -50|" "$UNDERVOLT_CONFIG"
		sudo sed -i "s|^undervolt 3 .*|undervolt 3 'System Agent' 0|" "$UNDERVOLT_CONFIG"
		sudo sed -i "s|^undervolt 4 .*|undervolt 4 'Analog I/O' 0|" "$UNDERVOLT_CONFIG"
		sudo sed -i "s|^tjoffset .*|tjoffset 0|" "$UNDERVOLT_CONFIG"
	fi

	sudo systemctl enable intel-undervolt 2>/dev/null
	sudo systemctl restart intel-undervolt 2>/dev/null
	log "intel-undervolt configured for $profile profile"
}

# ----------------------------------------------------------- apps & services

kill_applications() {
	profile="$1"

	if [ "$profile" = "maximum" ]; then
		apps="insync spotify_player firefox chrome brave chromium discord slack telegram thunderbird evolution dropbox onedrive nextcloud vlc mpv obs steam lutris wine redshift newsboat unclutter helium-browser"
	else
		apps="spotify_player discord slack steam lutris obs"
	fi

	log "scanning for applications to terminate..."
	for app in $apps; do
		pgrep -x "$app" >/dev/null 2>&1 || continue
		if maybe "Kill $app?" killall -TERM "$app" 2>/dev/null; then
			log "killed $app"
			printf '%s\n' "$app" >>"$KILLED_APPS"
		fi
	done
}

stop_services() {
	profile="$1"

	if [ "$profile" = "maximum" ]; then
		services="tailscaled preload libvirtd docker docker.socket containerd awsvpnclient cronie ufw firewalld fail2ban"
	else
		services="tailscaled preload libvirtd docker docker.socket containerd awsvpnclient"
	fi

	for service in $services; do
		systemctl is-active --quiet "$service" 2>/dev/null || continue
		if maybe "Stop service $service?" sudo systemctl stop "$service"; then
			log "stopped service: $service"
			printf '%s\n' "$service" >>"$STOPPED_SERVICES"
		fi
	done
}

# ------------------------------------------------------- display & hardware

dim_screen() {
	brightnessctl set "$1" >/dev/null 2>&1
	kill -45 "$(pidof dwmblocks)" 2>/dev/null
}

manage_display() {
	profile="$1"

	if [ "$profile" = "maximum" ]; then
		maybe "Set brightness to 1%?" dim_screen 1%
		[ -f "$WALLPAPER" ] &&
			maybe "Set black wallpaper?" feh --bg-fill "$WALLPAPER"
		maybe "Set DPMS to 60 seconds?" xset dpms 60 60 60
	else
		maybe "Set brightness to 30%?" dim_screen 30%
		maybe "Set DPMS to 120 seconds?" xset dpms 120 120 120
	fi
	maybe "Disable HDMI-1 output?" xrandr --output HDMI-1 --off

	log "display configured for $profile profile"
}

disable_bluetooth() {
	bluetoothctl power off 2>/dev/null
	sudo systemctl stop bluetooth 2>/dev/null
	kill -46 "$(pidof dwmblocks)" 2>/dev/null
}

disable_wifi() {
	sudo systemctl stop iwd 2>/dev/null
	rfkill block wifi 2>/dev/null
}

manage_hardware() {
	profile="$1"

	maybe "Switch to integrated GPU?" envycontrol -s integrated
	maybe "Disable Bluetooth?" disable_bluetooth
	maybe "Disable WiFi?" disable_wifi

	if [ "$profile" = "maximum" ]; then
		maybe "Disable swap?" sudo swapoff -a
		maybe "Stop PipeWire?" killall pipewire pipewire-pulse wireplumber
		if [ -f "$COMPOSITOR_SCRIPT" ]; then
			maybe "Stop compositor?" sh "$COMPOSITOR_SCRIPT"
		fi
	fi

	log "hardware configured for $profile profile"
}

# -------------------------------------------------------------------- actions

apply_profile() {
	profile="$1"

	log "applying profile: $profile"
	printf '%s\n' "$profile" >"$STATE_FILE"

	configure_tlp "$profile"
	configure_undervolt "$profile"
	kill_applications "$profile"
	stop_services "$profile"
	manage_display "$profile"
	manage_hardware "$profile"

	log "profile $profile applied"
	notify-send "Save battery" "Power saver + $profile profile applied."
}

restore_normal() {
	log "restoring normal state..."

	restore_config "$TLP_BACKUP" "$TLP_CONFIG"
	restore_config "$UNDERVOLT_BACKUP" "$UNDERVOLT_CONFIG"
	sudo systemctl restart intel-undervolt 2>/dev/null

	# Back to automatic AC/battery switching (also re-reads the restored config)
	disable_power_saver

	if [ -f "$STOPPED_SERVICES" ]; then
		while read -r service; do
			[ -n "$service" ] || continue
			sudo systemctl start "$service" 2>/dev/null &&
				log "restored service: $service"
		done <"$STOPPED_SERVICES"
		rm -f "$STOPPED_SERVICES"
	fi

	dim_screen 100%
	xset dpms 600 600 600 2>/dev/null

	rfkill unblock wifi 2>/dev/null
	rfkill unblock bluetooth 2>/dev/null
	sudo systemctl start iwd 2>/dev/null
	sudo systemctl start bluetooth 2>/dev/null
	sudo swapon -a 2>/dev/null
	kill -46 "$(pidof dwmblocks)" 2>/dev/null

	rm -f "$STATE_FILE" "$KILLED_APPS"

	log "normal state restored"
	notify-send "Save battery" "Normal state restored."
}

show_status() {
	profile=$(current_profile)
	[ -n "$profile" ] || err "could not read TLP status (is tlp installed?)"

	if [ -r /sys/class/power_supply/AC/online ] &&
		[ "$(cat /sys/class/power_supply/AC/online)" = "1" ]; then
		source="AC"
	else
		source="battery"
	fi

	applied=$(cat "$STATE_FILE" 2>/dev/null || echo "none")
	capacity=$(cat /sys/class/power_supply/BAT0/capacity 2>/dev/null || echo "?")
	governor=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo "?")
	platform=$(cat /sys/firmware/acpi/platform_profile 2>/dev/null || echo "?")

	printf 'TLP profile      : %s\n' "$profile"
	printf 'save-battery     : %s\n' "$applied"
	printf 'Power source     : %s\n' "$source"
	printf 'Battery          : %s%%\n' "$capacity"
	printf 'CPU governor     : %s\n' "$governor"
	printf 'Platform profile : %s\n' "$platform"

	[ -t 1 ] || notify-send "Save battery" \
		"TLP: $profile ($applied)
Source: $source ($capacity%)
Platform: $platform"
}

usage() {
	cat <<EOF
usage: save-battery [OPTIONS]

  -p, --profile PROFILE   maximum | balanced | none
  -a, --auto              apply without per-action prompts
  -i, --interactive       prompt for each action (default)
  -r, --restore           restore normal state and automatic TLP switching
  -s, --status            show the current status
  -h, --help              show this help

Every run (except --restore/--status) enables TLP's power-saver profile;
the chosen profile adds further optimisations on top of it.
EOF
}

# ----------------------------------------------------------------------- main

command -v tlp >/dev/null 2>&1 || err "tlp is not installed"
command -v dmenu >/dev/null 2>&1 || log "warning: dmenu not found, prompts will fail"

PROFILE=""
INTERACTIVE="true"

while [ $# -gt 0 ]; do
	case "$1" in
	-p | --profile)
		PROFILE="$2"
		shift 2
		;;
	-a | --auto)
		INTERACTIVE="false"
		shift
		;;
	-i | --interactive)
		INTERACTIVE="true"
		shift
		;;
	-r | --restore)
		restore_normal
		exit 0
		;;
	-s | --status)
		show_status
		exit 0
		;;
	-h | --help)
		usage
		exit 0
		;;
	*)
		printf 'error: unknown option: %s\n' "$1" >&2
		usage >&2
		exit 2
		;;
	esac
done

if [ -z "$PROFILE" ]; then
	choice=$(printf 'Maximum battery\nBalanced\nPower saver only\nRestore normal\nStatus' |
		dmenu -p "Save battery [$(current_profile)]:")
	case "$choice" in
	"Maximum battery") PROFILE="maximum" ;;
	"Balanced") PROFILE="balanced" ;;
	"Power saver only") PROFILE="none" ;;
	"Restore normal")
		restore_normal
		exit 0
		;;
	"Status")
		show_status
		exit 0
		;;
	*) exit 0 ;;
	esac
fi

# TLP power-saver is applied on every run, whichever profile was chosen.
enable_power_saver

case "$PROFILE" in
maximum | balanced)
	apply_profile "$PROFILE"
	;;
none)
	printf '%s\n' "none" >"$STATE_FILE"
	notify-send "Save battery" "TLP power-saver enabled — no extra changes."
	;;
*)
	err "invalid profile: $PROFILE (expected maximum, balanced or none)"
	;;
esac
