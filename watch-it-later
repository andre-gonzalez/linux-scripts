#!/bin/sh

. "$HOME/.scripts/.env/youtarr"

video_url=$(printf '%s' "${1:-$(xclip -o -sel clip)}" | tr -d '[:space:]"\\')

youtarr_host="https://youtarr.franktech.dev"

if [ -z "$youtarr_api_key" ]; then
	notify-send -u critical "Youtarr" "Missing youtarr_api_key in ~/.scripts/.env/youtarr"
	exit 1
fi

case "$video_url" in
*youtube.com/* | *youtu.be/*) ;;
*)
	notify-send -u critical "Youtarr" "Not a YouTube URL: ${video_url:-empty}"
	exit 1
	;;
esac

response=$(curl -s -w '\n%{http_code}' \
	-X POST "$youtarr_host/api/videos/download" \
	-H "Content-Type: application/json" \
	-H "x-api-key: $youtarr_api_key" \
	-d "{\"url\":\"$video_url\"}")

status=$(printf '%s' "$response" | tail -n 1)
body=$(printf '%s' "$response" | sed '$d')
message=$(printf '%s' "$body" | grep -o '"message":"[^"]*"' | cut -d'"' -f4)

case "$status" in
200) notify-send "Youtarr" "${message:-Queued}: $video_url" ;;
401)
	notify-send -u critical "Youtarr" "Authentication Error"
	exit 1
	;;
409)
	notify-send -u critical "Youtarr" "Downloads paused: storage limit reached"
	exit 1
	;;
429)
	notify-send -u critical "Youtarr" "Rate limit exceeded"
	exit 1
	;;
*)
	notify-send -u critical "Youtarr" "Error $status: ${message:-$video_url}"
	exit 1
	;;
esac
