#!/bin/sh
# power-saver — switch TLP between its power-saver profile and automatic
# AC/battery switching.
#
# TLP 1.9+ has three profiles: performance (AC), balanced (BAT) and
# power-saver. The first two are selected automatically from the power
# source; power-saver is manual only and applies every *_ON_SAV setting
# from /etc/tlp.conf. Use it to stretch the battery on a long flight.
#
# Usage:
#   power-saver            interactive menu (dmenu)
#   power-saver on         enable power-saver profile
#   power-saver off        back to automatic AC/battery switching
#   power-saver toggle     flip between the two
#   power-saver status     print the current profile
#
# Returning to automatic is just `tlp start`, which re-reads the config
# and re-applies the profile matching the current power source.

set -e

TERMINAL="st"

err() {
	printf 'error: %s\n' "$1" >&2
	notify-send -u critical "Power saver" "$1" 2>/dev/null || true
	exit 1
}

# Current profile as reported by TLP, e.g. "power-saver/BAT" -> "power-saver"
current_profile() {
	tlp-stat -s 2>/dev/null |
		sed -n 's/^TLP profile[[:space:]]*=[[:space:]]*\([^/]*\).*/\1/p' |
		tr -d ' '
}

# Run a tlp subcommand as root. sudo is used non-interactively when the
# credentials are already cached; otherwise fall back to a terminal so the
# password can be typed (this script is normally launched from dmenu, which
# has no tty of its own).
run_tlp() {
	if sudo -n true 2>/dev/null; then
		sudo tlp "$1" >/dev/null 2>&1 || err "tlp $1 failed"
	elif [ -t 0 ]; then
		sudo tlp "$1" >/dev/null || err "tlp $1 failed"
	else
		"$TERMINAL" -e sudo tlp "$1" ||
			err "tlp $1 failed (could not obtain root)"
	fi
}

enable_saver() {
	if [ "$(current_profile)" = "power-saver" ]; then
		notify-send "Power saver" "Already active."
		return 0
	fi
	run_tlp power-saver
	notify-send "Power saver" "Enabled — aggressive settings applied."
}

disable_saver() {
	if [ "$(current_profile)" != "power-saver" ]; then
		notify-send "Power saver" "Already on automatic AC/battery switching."
		return 0
	fi
	run_tlp start
	notify-send "Power saver" "Disabled — back to automatic (now: $(current_profile))."
}

toggle_saver() {
	if [ "$(current_profile)" = "power-saver" ]; then
		disable_saver
	else
		enable_saver
	fi
}

show_status() {
	profile=$(current_profile)
	[ -n "$profile" ] || err "could not read TLP status (is tlp installed?)"

	if [ -r /sys/class/power_supply/AC/online ] &&
		[ "$(cat /sys/class/power_supply/AC/online)" = "1" ]; then
		source="AC"
	else
		source="battery"
	fi

	capacity=$(cat /sys/class/power_supply/BAT0/capacity 2>/dev/null || echo "?")
	governor=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo "?")
	platform=$(cat /sys/firmware/acpi/platform_profile 2>/dev/null || echo "?")

	printf 'TLP profile      : %s\n' "$profile"
	printf 'Power source     : %s\n' "$source"
	printf 'Battery          : %s%%\n' "$capacity"
	printf 'CPU governor     : %s\n' "$governor"
	printf 'Platform profile : %s\n' "$platform"

	[ -t 1 ] || notify-send "Power saver" \
		"Profile: $profile
Source: $source ($capacity%)
Platform: $platform"
}

menu() {
	choice=$(printf 'Enable power saver\nBack to automatic\nStatus' |
		dmenu -p "TLP [$(current_profile)]:")

	case "$choice" in
	"Enable power saver")
		enable_saver
		;;
	"Back to automatic")
		disable_saver
		;;
	"Status")
		show_status
		;;
	*)
		exit 0
		;;
	esac
}

command -v tlp >/dev/null 2>&1 || err "tlp is not installed"

case "${1:-}" in
on | enable | power-saver) enable_saver ;;
off | disable | auto | start) disable_saver ;;
toggle) toggle_saver ;;
status) show_status ;;
"") menu ;;
*)
	printf 'usage: %s [on|off|toggle|status]\n' "$(basename "$0")" >&2
	exit 2
	;;
esac
