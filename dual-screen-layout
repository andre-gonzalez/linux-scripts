#!/bin/sh

# Laptop panel on the left, ultrawide (primary, 2560x1080@100) on its right.
# The layout lives in the autorandr profile ~/.config/autorandr/dual; the
# postswitch hook there does the rest (DPI, keyboard, wallpaper, status bar,
# pointer on the primary). To change the layout, arrange the screens and run
# `autorandr --save dual --force`.
exec autorandr --load dual
